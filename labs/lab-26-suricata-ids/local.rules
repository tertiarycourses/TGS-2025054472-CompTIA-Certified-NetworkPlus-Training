# Lab 26 — custom Suricata rules for the Network+ IDS lab.
#
# The Emerging Threats feed pulled in by `suricata-update` covers real threats.
# These local rules are deliberately simple so you can read a signature end to
# end and watch YOUR OWN rule fire in fast.log and eve.json.
#
# Install with:
#   cp local.rules /etc/suricata/rules/local.rules
# and make sure /etc/suricata/suricata.yaml lists it:
#   rule-files:
#     - suricata.rules
#     - local.rules
#
# Signature anatomy:
#   action proto src_ip src_port -> dst_ip dst_port (options)
# sid: must be >= 1000000 for local rules; rev: increments on every edit.

# --- 1. The Step 4 trigger -----------------------------------------------------
# testmynids.org/uid/index.html returns the text "uid=0(root) gid=0(root)".
# This is the same behaviour as the ET rule "GPL ATTACK_RESPONSE id check
# returned root", written locally so you can see your own sid in the alert.
alert http any any -> any any (msg:"LOCAL NETPLUS id check returned root"; \
    flow:established,to_client; \
    content:"uid=0|28|root|29|"; \
    classtype:bad-unknown; sid:1000001; rev:1;)

# --- 2. Cleartext credentials on the wire --------------------------------------
alert tcp any any -> any 21 (msg:"LOCAL NETPLUS cleartext FTP login attempt"; \
    flow:established,to_server; \
    content:"USER "; depth:5; \
    classtype:protocol-command-decode; sid:1000002; rev:1;)

# --- 3. Telnet must not exist on a modern network ------------------------------
alert tcp any any -> any 23 (msg:"LOCAL NETPLUS Telnet session to a managed host"; \
    flow:established,to_server; \
    classtype:policy-violation; sid:1000003; rev:1;)

# --- 4. Horizontal port scan — matches the port-scanning pattern from Lab 25 ----
alert tcp any any -> $HOME_NET any (msg:"LOCAL NETPLUS possible TCP SYN port scan"; \
    flags:S; \
    threshold:type both, track by_src, count 30, seconds 10; \
    classtype:attempted-recon; sid:1000004; rev:1;)

# --- 5. ICMP flood — the DoS scenario in the TIS Cybersecurity Simulator --------
alert icmp any any -> $HOME_NET any (msg:"LOCAL NETPLUS ICMP flood (possible DoS)"; \
    itype:8; \
    threshold:type both, track by_src, count 100, seconds 5; \
    classtype:attempted-dos; sid:1000005; rev:1;)

# --- 6. Database exposed beyond the allowed subnet (ties to Lab 27's ACL) -------
alert tcp !10.0.0.0/24 any -> $HOME_NET 3306 (msg:"LOCAL NETPLUS MySQL access from outside the permitted subnet"; \
    flow:to_server; \
    classtype:policy-violation; sid:1000006; rev:1;)
