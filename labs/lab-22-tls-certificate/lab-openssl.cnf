# Lab 22 — OpenSSL configuration for the lab.local server certificate.
#
# The README's Step 2 one-liner uses only -subj "/CN=lab.local". This file is the
# same certificate expressed as a reusable config, plus the Subject Alternative
# Name that modern clients (Chrome, Firefox, curl without -k) actually require —
# CN alone has been ignored for host matching since ~2017.
#
# Use it with:
#   openssl req -x509 -newkey rsa:2048 -nodes \
#     -keyout /etc/ssl/private/lab.key \
#     -out    /etc/ssl/certs/lab.crt \
#     -days 365 -config lab-openssl.cnf -extensions v3_req
#
# NOTE: this file contains NO key material. The private key is generated at run
# time by openssl and never committed.

[ req ]
default_bits        = 2048
default_md          = sha256
prompt              = no
encrypt_key         = no
distinguished_name  = req_distinguished_name
x509_extensions     = v3_req

[ req_distinguished_name ]
CN = lab.local
O  = Tertiary Infotech Academy
OU = Network Plus Lab
C  = SG

[ v3_req ]
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectAltName         = @alt_names

[ alt_names ]
DNS.1 = lab.local
DNS.2 = localhost
IP.1  = 127.0.0.1
